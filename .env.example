APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional provider delivery-event contract. Leave disabled until a concrete provider adapter is selected.
EMAIL_DELIVERY_WEBHOOK_ENABLED=false
EMAIL_DELIVERY_PROVIDER=
EMAIL_DELIVERY_WEBHOOK_SECRET=
EMAIL_DELIVERY_WEBHOOK_TOLERANCE_SECONDS=300

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Server-side token for the RetailPOS public website lead proxy. Do not expose this in browser code.
RETAILPOS_PUBLIC_LEAD_TOKEN=
RETAILPOS_PUBLIC_LEAD_COMPANY_ID=
RETAILPOS_PUBLIC_LEAD_ASSIGNEE_ID=
RETAILPOS_PUBLIC_LEAD_RATE_LIMIT=30
RETAILPOS_PUBLIC_LEAD_MAX_PAYLOAD_KB=64

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://app.retailpos.biz/integrations/google/callback

# Optional lead-alert email delivery. In-app lead alerts remain enabled by default.
RETAILPOS_LEAD_EMAIL_NOTIFICATIONS=false
RETAILPOS_LEAD_NOTIFY_EMAIL=

# SaaS entitlement checks remain opt-in during a controlled package rollout.
SAAS_ENTITLEMENT_ENFORCEMENT=false
# Mobile account verification is provider-neutral in this release. Configure an adapter separately.
SAAS_MOBILE_OTP_PROVIDER=
SAAS_PUBLIC_SIGNUP_ENABLED=false
SAAS_PUBLIC_SIGNUP_EMAIL_OTP_ENABLED=true
SAAS_PUBLIC_SIGNUP_MOBILE_OTP_ENABLED=false
SAAS_TERMS_URL=/terms
SAAS_PRIVACY_URL=/privacy
SAAS_TERMS_VERSION=v1
SAAS_PRIVACY_VERSION=v1
STORE_SETUP_WIZARD_ENABLED=true
STORE_SETUP_PRODUCT_IMPORT_ENABLED=true
STORE_SETUP_SCANNER_TEST_ENABLED=true
STORE_SETUP_RECOMMENDATIONS_ENABLED=true
MULTI_OUTLET_ENABLED=true
MULTI_OUTLET_SETUP_ENABLED=true
MULTI_OUTLET_TRANSFERS_ENABLED=true
MULTI_OUTLET_REPORTING_ENABLED=true
